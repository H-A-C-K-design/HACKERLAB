# CyberForge Academy - Unified Root Environment Configuration
# Copy this file to server/.env and client/.env or use as reference

# ── Backend Configuration ──
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost
TRUST_PROXY=0

# Database (PostgreSQL URL)
DATABASE_URL=postgresql://cyberforge:cyberforge_password@localhost:5432/cyberforge_academy?schema=public

# Auth
JWT_ACCESS_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
FIELD_ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtc2VjcmV0LWtleS12YWx1ZQ==

# Email (Resend)
RESEND_API_KEY=re_mock_api_key_for_dev
EMAIL_FROM="CyberForge Academy <no-reply@mail.cyberforge.academy>"
EMAIL_REPLY_TO=support@cyberforge.academy

# Razorpay
RAZORPAY_KEY_ID=rzp_test_cyberforge123
RAZORPAY_KEY_SECRET=rzp_secret_cyberforge123
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_cyberforge123
RAZORPAY_TEACHER_PLAN_ID=plan_cyberforge_teacher_monthly
TEACHER_MONTHLY_FEE_PAISE=40000
PLATFORM_COMMISSION_PERCENT=0
PAYOUT_DELAY_DAYS=7
SUBSCRIPTION_GRACE_DAYS=3

# LiveKit (live streaming)
LIVEKIT_URL=wss://live.cyberforge.academy
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Storage (Cloudflare R2, S3 compatible)
R2_ACCOUNT_ID=mock_r2_account
R2_ACCESS_KEY_ID=mock_r2_key
R2_SECRET_ACCESS_KEY=mock_r2_secret
R2_BUCKET_PUBLIC_ASSETS=cf-public
R2_BUCKET_PRIVATE=cf-private
R2_SIGNED_URL_TTL_SECONDS=900

# Rate limits
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=100

# ── Frontend Configuration ──
VITE_API_URL=http://localhost:4000
VITE_APP_NAME=CyberForge Academy
VITE_RAZORPAY_KEY_ID=rzp_test_cyberforge123
VITE_LIVEKIT_URL=wss://live.cyberforge.academy
VITE_SUPPORT_EMAIL=support@cyberforge.academy
